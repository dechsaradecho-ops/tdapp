# ---- Supabase ----
# (คัดลอกจาก Supabase Dashboard → Connect/Edge Functions → Set environment variables)
SUPABASE_URL=https://gchfxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx
SUPABASE_SECRET_KEY=sb_secret_xxxx
SUPABASE_JWKS_URL=https://gchfxxxx.supabase.co/auth/v1/.well-known/jwks.json
# Legacy names (ยังใช้ได้ ถ้าโปรเจกต์เก่ายังเป็น JWT keys)
# SUPABASE_SERVICE_KEY=eyJhbGci...
# SUPABASE_ANON_KEY=eyJhbGci...

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- AI Provider: deepseek | glm ----
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ---- LINE Messaging API ----
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# Bot's own user ID (U...) — required for @mention detection in group chats
LINE_BOT_USER_ID=

# ---- Market data ----
# Twelve Data free key สำหรับราคาทอง XAU/USD (สมัครฟรี: twelvedata.com)
# คู่เงิน FX (EURUSD/GBPUSD/USDJPY/AUDUSD) ใช้ Frankfurter — ไม่ต้องมี key
TWELVEDATA_API_KEY=

# ---- Risk defaults ----
DEFAULT_RISK_PER_TRADE=0.5
DEFAULT_MAX_DAILY_LOSS=2.0
DEFAULT_MAX_WEEKLY_LOSS=5.0
DEFAULT_MAX_MONTHLY_LOSS=8.0
DEFAULT_MAX_DRAWDOWN=10.0

# ---- App ----
APP_ENV=development
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:3000
